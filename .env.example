OPENAI_API_KEY=your_openai_api_key

# Microsoft delegated login (use an app registration that supports personal accounts).
MICROSOFT_TENANT_ID=your_microsoft_tenant_id
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
AUTH_SESSION_SECRET=replace_with_at_least_32_random_characters

# Excel storage configuration (not used by Microsoft login).
ONEDRIVE_FILE_ID=your_onedrive_excel_file_id
EXCEL_TABLE_NAME=your_excel_table_name
